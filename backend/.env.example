# Backend Environment Variables Example
# Copy this file to .env and fill in your actual values

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/arcs_db?retryWrites=true&w=majority

# JWT Secret (generate a random string)
JWT_SECRET=your-super-secret-jwt-key-here-change-this

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=ransomware-events

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# ML Model Path
MODEL_PATH=ml_engine/models/isolation_forest.joblib

# Optional: Supabase (if using server-side verification)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key-here
