# Backend Environment Variables Example
# Copy this file to .env and fill in your actual values

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/arcs_db?retryWrites=true&w=majority

# JWT Secret (generate a random string)
JWT_SECRET=your-super-secret-jwt-key-here-change-this

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=ransomware-events

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# ML Model Path
MODEL_PATH=ml_engine/models/isolation_forest.joblib

# SendGrid Email Alerts
SENDGRID_API_KEY=your_sendgrid_api_key_here
ALERT_FROM_EMAIL=alerts@your-domain.com
ADMIN_EMAIL=admin@your-domain.com

# Twilio SMS Alerts
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
ADMIN_PHONE_NUMBER=+919876543210

# Supabase Configuration (Required for User Management)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

