# Frontend Environment Variables Example
# Copy this file to frontend/.env and fill in your actual values

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: hCaptcha (if you want to enable captcha later)
# VITE_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key-here
